{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "k9b Helm Chart Values",
  "description": "Schema validation for k9b Helm chart values",
  "type": "object",
  "required": ["image"],
  "properties": {
    "image": {
      "type": "object",
      "description": "Container image configuration",
      "properties": {
        "backend": {
          "type": "object",
          "description": "Backend (Python) image settings",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "description": "Docker image repository for backend"
            },
            "tag": {
              "type": "string",
              "description": "Docker image tag for backend"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"],
              "default": "IfNotPresent"
            }
          }
        },
        "frontend": {
          "type": "object",
          "description": "Frontend (Node.js) image settings",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "description": "Docker image repository for frontend"
            },
            "tag": {
              "type": "string",
              "description": "Docker image tag for frontend"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"],
              "default": "IfNotPresent"
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "description": "Backend service configuration",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 8080
            }
          }
        },
        "env": {
          "type": "object",
          "description": "Backend environment variables",
          "properties": {
            "K9B_ENABLE_DEBUG_ENDPOINTS": {
              "type": "string",
              "description": "Enable UI debug diagnostics endpoints (/api/debug/*). Set to 'true' to show diagnostic execution details button in the UI.",
              "default": "false"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "description": "Scheduler service configuration",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "frontend": {
      "type": "object",
      "description": "Frontend service configuration",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 5173
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "description": "Ingress configuration for external access. Routes all traffic to the frontend service, which proxies /api/ to the backend internally.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable ingress resource creation",
          "default": false
        },
        "className": {
          "type": "string",
          "description": "Ingress class name (e.g., nginx, traefik). Empty string means use default ingress class."
        },
        "annotations": {
          "type": "object",
          "description": "Annotations to add to the Ingress metadata. Use for ingress controller-specific settings (e.g., cert-manager.io/cluster-issuer, nginx.ingress.kubernetes.io/auth-type).",
          "default": {},
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "description": "List of ingress hosts with paths",
          "default": [],
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": {
                "type": "string",
                "description": "Hostname for the ingress rule (e.g., k9b.example.com)"
              },
              "paths": {
                "type": "array",
                "description": "List of paths for this host",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "URL path to match (e.g., /)",
                      "default": "/"
                    },
                    "pathType": {
                      "type": "string",
                      "description": "Path matching type (Prefix, Exact, ImplementationSpecific)",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"],
                      "default": "Prefix"
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "description": "TLS configuration for secure ingress",
          "default": [],
          "items": {
            "type": "object",
            "required": ["secretName", "hosts"],
            "properties": {
              "secretName": {
                "type": "string",
                "description": "Name of the Kubernetes Secret containing the TLS certificate and key"
              },
              "hosts": {
                "type": "array",
                "description": "List of hostnames covered by the TLS certificate",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "kubeconfig": {
      "type": "object",
      "description": "External kubeconfig secret configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable kubeconfig secret mount",
          "default": false
        },
        "secretName": {
          "type": "string",
          "default": "k9b-kubeconfig"
        },
        "mountPath": {
          "type": "string",
          "default": "/app/kubeconfig"
        },
        "fileName": {
          "type": "string",
          "default": "config"
        }
      }
    },
    "healthConfig": {
      "type": "object",
      "description": "External health config ConfigMap configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable health config ConfigMap mount",
          "default": false
        },
        "configMapName": {
          "type": "string",
          "default": "k9b-health-config"
        },
        "mountPath": {
          "type": "string",
          "default": "/app/runs"
        },
        "fileName": {
          "type": "string",
          "default": "health-config.json"
        }
      }
    }
  }
}

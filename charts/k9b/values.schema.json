{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "k9b Helm Chart Values",
  "description": "Schema validation for k9b Helm chart values",
  "type": "object",
  "required": ["image"],
  "properties": {
    "image": {
      "type": "object",
      "description": "Container image configuration",
      "properties": {
        "backend": {
          "type": "object",
          "description": "Backend (Python) image settings",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "description": "Docker image repository for backend"
            },
            "tag": {
              "type": "string",
              "description": "Docker image tag for backend"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"],
              "default": "IfNotPresent"
            }
          }
        },
        "frontend": {
          "type": "object",
          "description": "Frontend (Node.js) image settings",
          "required": ["repository", "tag"],
          "properties": {
            "repository": {
              "type": "string",
              "description": "Docker image repository for frontend"
            },
            "tag": {
              "type": "string",
              "description": "Docker image tag for frontend"
            },
            "pullPolicy": {
              "type": "string",
              "enum": ["IfNotPresent", "Always", "Never"],
              "default": "IfNotPresent"
            }
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "description": "Backend service configuration",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 8080
            }
          }
        }
      }
    },
    "scheduler": {
      "type": "object",
      "description": "Scheduler service configuration",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    },
    "frontend": {
      "type": "object",
      "description": "Frontend service configuration",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 5173
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "description": "Ingress configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "default": {}
        }
      }
    },
    "kubeconfig": {
      "type": "object",
      "description": "External kubeconfig secret configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable kubeconfig secret mount",
          "default": false
        },
        "secretName": {
          "type": "string",
          "default": "k9b-kubeconfig"
        },
        "mountPath": {
          "type": "string",
          "default": "/app/kubeconfig"
        },
        "fileName": {
          "type": "string",
          "default": "config"
        }
      }
    },
    "healthConfig": {
      "type": "object",
      "description": "External health config ConfigMap configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable health config ConfigMap mount",
          "default": false
        },
        "configMapName": {
          "type": "string",
          "default": "k9b-health-config"
        },
        "mountPath": {
          "type": "string",
          "default": "/app/runs"
        },
        "fileName": {
          "type": "string",
          "default": "health-config.json"
        }
      }
    }
  }
}

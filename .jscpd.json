{
  "threshold": 4.0,
  "reporters": ["console", "json"],
  "output": "artifacts/jscpd",
  "mode": "mild",
  "minLines": 8,
  "minTokens": 80,
  "absolute": false,
  "ignore": [
    "**/.git/**",
    "**/.venv/**",
    "**/venv/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/coverage/**",
    "**/coverage_html/**",
    "**/htmlcov/**",
    "**/__pycache__/**",
    "**/__snapshots__/**",
    "**/*.min.js",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/artifacts/**",
    "**/runs/**",
    "**/fixtures/**",
    "**/snapshots/**",
    "**/.hypothesis/**",
    "**/evals/**",
    "**/.kilocode/**",
    "**/.dirac-symbol-index/**",
    "**/provider-smoke/**",
    "**/podman/**",
    "**/scripts/**"
  ]
}
